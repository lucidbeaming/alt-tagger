# Required: OpenAI API key for Vision (alt text generation)
OPENAI_API_KEY=

# Optional: Cloudinary cloud name (if not parsed from input JSON secure_url)
CLOUDINARY_CLOUDNAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=

# Optional: Paths and behavior (defaults shown)
TAGGER_INPUT=cloudinary-resources.json
TAGGER_OUTPUT=alt-tags.json
TAGGER_DOWNLOADS=downloads
TAGGER_DELAY_MS=25000
TAGGER_LIMIT=750
TAGGER_MODEL=gpt-4o-mini
TAGGER_VERBOSE=1
